<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <application android:name=".app.KeyVoxApplication" android:label="@string/app_name" android:allowBackup="false"
        android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <activity android:name=".app.KeyVoxActivity" android:exported="true"
            android:theme="@style/Theme.KeyVox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".dictation.DictationCaptureService" android:exported="false"
            android:foregroundServiceType="microphone" />
        <service android:name=".ime.KeyVoxInputMethodService" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
    </application>
</manifest>
