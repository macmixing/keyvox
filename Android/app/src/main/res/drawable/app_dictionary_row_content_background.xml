<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_screen_background" />
            <corners android:radius="@dimen/app_row_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_row_fill" />
            <stroke android:width="1dp" android:color="@color/app_row_stroke" />
            <corners android:radius="@dimen/app_row_corner_radius" />
        </shape>
    </item>
</layer-list>
