+extern "C" bool keyvox_whisper_load_encoder(void *context, const char *plugin_path,
+                                            const char *model_path, const char *runtime_directory) {
+    if (!context) return false;
+    auto &ctx = *static_cast<whisper_context *>(context);
+    if (ctx.params.flash_attn) return false;
+    const auto &hp = ctx.model.hparams;
+    const kv_whisper_encoder_dimensions dimensions = {
+        uint32_t(hp.n_mels), uint32_t(hp.n_audio_ctx), uint32_t(hp.n_text_state),
+        uint32_t(hp.n_text_head), uint32_t(hp.n_text_layer)
+    };
+    try {
+        auto encoder = keyvox::ExternalEncoder::load(plugin_path, model_path, runtime_directory, dimensions);
+        if (!encoder) return false;
+        ctx.external_encoder = std::move(encoder);
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
