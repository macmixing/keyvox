    },
    "%@ is ready. You can start KeyVox Speak from the Home tab now." : {
      "comment" : "Hint on the KeyVox Speak setup page when the voice is installed. KeyVox Speak is a brand name and stays in English. The placeholder is the voice name, which stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist bereit. Du kannst KeyVox Speak jetzt im Tab „Home“ starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La voz %@ está lista. Ya puedes iniciar KeyVox Speak desde la pestaña Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La voix %@ est prête. Vous pouvez lancer KeyVox Speak depuis l’onglet Accueil."
          }
        }
      }
    },
