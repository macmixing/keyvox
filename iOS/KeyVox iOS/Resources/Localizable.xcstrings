        }
      },
      "shouldTranslate" : false
    },
    "%@ (%@)" : {
      "comment" : "Status on a dictation model row that is not installed. The first placeholder is the install status and the second is the approximate download size.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@ is installed, selected, and ready for KeyVox Speak." : {
      "comment" : "Install status on the KeyVox Speak setup card when the voice is ready. KeyVox Speak is a brand name and stays in English. The placeholder is the voice name, which stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist installiert, ausgewählt und bereit für KeyVox Speak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La voz %@ está instalada, seleccionada y lista para KeyVox Speak."
