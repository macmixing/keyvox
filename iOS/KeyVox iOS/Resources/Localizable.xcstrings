      "shouldTranslate" : false
    },
    "%@ %@" : {
      "comment" : "Dictation model install status. The first placeholder is the current install step and the second is the percent complete.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
