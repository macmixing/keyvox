    "Check out the reversible writing styles available with KeyVox Vibes." : {
      "comment" : "Summary on the KeyVox Vibes card in Settings before the Vibes model is installed. KeyVox Vibes is a brand name and stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entdecke die umkehrbaren Schreibstile von KeyVox Vibes."
          }
        },
