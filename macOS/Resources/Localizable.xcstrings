{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "%@ (Recommended)" : {
      "comment" : "Microphone picker entry for the recommended microphone in Settings. %@ is the microphone's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (empfohlen)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (recomendado)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ (recommandé)"
          }
        }
      }
    },
    "%@ Your current Parakeet model is still installed." : {
      "comment" : "Message of the prompt shown when the Parakeet dictation model update fails. %@ is the error message, which is a full sentence. Parakeet is a brand name and stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Dein aktuelles Parakeet-Modell ist weiterhin installiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Tu modelo Parakeet actual sigue instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Votre modèle Parakeet actuel est toujours installé."
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Download size progress in the KeyVox update window. The first %@ is the amount downloaded and the second %@ is the total size; both are formatted file sizes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ von %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ de %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sur %@"
          }
        }
      }
    },
    "%@ selected." : {
      "comment" : "Subtitle of the Mic Input card in Settings. %@ is the selected microphone's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sélectionné."
          }
        }
      }
    },
    "%@ selected. Bluetooth devices may start slower and reduce dictation accuracy." : {
      "comment" : "Subtitle of the Mic Input card in Settings. Shown when a Bluetooth microphone is chosen. Bluetooth is a brand name and stays in English. %@ is the selected microphone's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ausgewählt. Bluetooth-Geräte starten eventuell langsamer und können die Diktiergenauigkeit verringern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ seleccionado. Los dispositivos Bluetooth pueden tardar más en iniciarse y reducir la precisión del dictado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sélectionné. Les appareils Bluetooth peuvent démarrer plus lentement et réduire la précision de la dictée."
          }
        }
      }
    },
    "%@ selected. Built-in Microphone is still recommended for best speed." : {
      "comment" : "Subtitle of the Mic Input card in Settings. Shown when a wired or other microphone is chosen. Built-in Microphone is the macOS name for the Mac's own microphone; use the name macOS uses in this language. %@ is the selected microphone's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ausgewählt. Für die beste Geschwindigkeit wird weiterhin das integrierte Mikrofon empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ seleccionado. Para obtener la máxima velocidad, se sigue recomendando el micrófono integrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sélectionné. Le micro intégré reste recommandé pour une rapidité optimale."
          }
        }
      }
    },
    "%@ selected. Recommended for fastest startup and best reliability." : {
      "comment" : "Subtitle of the Mic Input card in Settings. Shown when the Mac's own microphone is chosen. %@ is the selected microphone's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ausgewählt. Empfohlen für den schnellsten Start und die höchste Zuverlässigkeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ seleccionado. Recomendado para un inicio más rápido y la máxima fiabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sélectionné. Recommandé pour un démarrage plus rapide et une fiabilité optimale."
          }
        }
      }
    },
    "%@ selected. This microphone may start slower and reduce dictation accuracy." : {
      "comment" : "Subtitle of the Mic Input card in Settings. Shown when AirPods are chosen. %@ is the selected microphone's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ausgewählt. Dieses Mikrofon startet eventuell langsamer und kann die Diktiergenauigkeit verringern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ seleccionado. Este micrófono puede tardar más en iniciarse y reducir la precisión del dictado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sélectionné. Ce micro peut démarrer plus lentement et réduire la précision de la dictée."
          }
        }
      }
    },
    "%@ will be removed from this Mac." : {
      "comment" : "Message of the confirmation prompt for deleting a dictation model in Settings. %@ is the model's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ wird von diesem Mac entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ se eliminará de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sera supprimé de ce Mac."
          }
        }
      }
    },
    "%lld" : {
      "shouldTranslate" : false
    },
    "A new version of KeyVox is available." : {
      "comment" : "Release summary shown in the KeyVox update window when the release has no summary. KeyVox is a brand name and stays in English.\nStatus text shown in the KeyVox update window when an update is available. KeyVox is a brand name and stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine neue Version von KeyVox ist verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hay una nueva versión de KeyVox disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une nouvelle version de KeyVox est disponible."
          }
        }
      }
    },
    "A new version of KeyVox is available. Please update for the best experience." : {
      "comment" : "Message in the update available prompt when the release has no summary. KeyVox is a brand name and stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine neue Version von KeyVox ist verfügbar. Bitte aktualisiere, um KeyVox optimal zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hay una nueva versión de KeyVox disponible. Actualiza para disfrutar de la mejor experiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une nouvelle version de KeyVox est disponible. Effectuez la mise à jour pour profiter d’une expérience optimale."
          }
        }
      }
    },
    "A newer Parakeet model is available for on-device dictation. Download the updated Parakeet model now (%@), or do it later from Settings." : {
      "comment" : "Message of the prompt offering a Parakeet dictation model update. %@ is the approximate download size. Settings is the KeyVox settings window. Parakeet is a brand name and stays in English.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein neueres Parakeet-Modell für das Diktieren auf dem Gerät ist verfügbar. Lade das aktualisierte Parakeet-Modell jetzt (%@) oder später in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hay un modelo Parakeet más reciente para el dictado en el dispositivo. Descarga ahora el modelo Parakeet actualizado (%@) o hazlo más tarde desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un modèle Parakeet plus récent est disponible pour la dictée sur l’appareil. Téléchargez dès maintenant le modèle Parakeet mis à jour (%@) ou faites-le plus tard depuis les Réglages."
          }
        }
      }
    },
