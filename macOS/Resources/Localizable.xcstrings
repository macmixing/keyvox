    },
    "Add custom words, email addresses, and short phrases to improve transcription accuracy." : {
      "comment" : "Description on the Dictionary card in Settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge eigene Wörter, E-Mail-Adressen und kurze Phrasen hinzu, um die Transkription genauer zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade palabras personalizadas, direcciones de correo electrónico y frases cortas para mejorar la precisión de la transcripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez des mots personnalisés, des adresses e-mail et de courtes expressions pour améliorer la précision de la transcription."
          }
        }
      }
    },
    "Adjust volume" : {
      "comment" : "Label above the sound volume slider in Settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lautstärke anpassen"
          }
        },
        "es" : {
          "stringUnit" : {
