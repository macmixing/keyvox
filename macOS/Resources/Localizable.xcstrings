        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Régler le volume"
          }
        }
      }
    },
    "After this, you may never type again." : {
      "comment" : "Subtitle of the onboarding setup screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Danach tippst du vielleicht nie wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Después de esto, puede que nunca vuelvas a escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après ça, vous risquez de ne plus jamais taper au clavier."
          }
        }
      }
    },
    "Another model is downloading. Try again when it finishes." : {
      "comment" : "Error in the Parakeet model update prompt when another dictation model is already downloading.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein anderes Modell wird gerade geladen. Versuche es erneut, wenn der Vorgang abgeschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
